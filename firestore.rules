rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public aggregate site statistics and visitor counter
    match /site_stats/{docId} {
      // Anyone can read aggregate stats and visitor count
      allow read: if true;

      // Allow atomic visitor count increment:
      // Can only change totalVisits (increment by 1) and/or lastVisitAt, or write if authenticated
      allow update: if (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalVisits', 'lastVisitAt']) &&
        request.resource.data.totalVisits == resource.data.totalVisits + 1
      ) || request.auth != null;

      // Allow authenticated users / auditor to initialize or update
      allow create, delete: if request.auth != null;
    }

    // User private expenses: only the owning user or auditor can read/write
    match /expenses/{expenseId} {
      allow read, write: if request.auth != null && (
        (resource != null && resource.data.userId == request.auth.uid) ||
        (request.resource != null && request.resource.data.userId == request.auth.uid) ||
        request.auth.token.email == 'stats-auditor@autopay.dev'
      );
    }

    // User settings: document ID is user's UID
    match /settings/{userId} {
      allow read, write: if request.auth != null && (
        request.auth.uid == userId ||
        request.auth.token.email == 'stats-auditor@autopay.dev'
      );
    }
  }
}
